# Copy to .env.local (gitignored) and fill in your own values.
NEXT_PUBLIC_GITHUB_REPO=your-username/your-fork
# Preview/test link for content/presentations/example-placeholder.md.
# Point this at a Google Slides deck shared to your org (never "Anyone with the link") --
# each maintainer sets their own, so no real deck link is committed to this repo.
EXAMPLE_PRESENTATION_SLIDES_URL=https://docs.google.com/presentation/d/REPLACE_ME/edit